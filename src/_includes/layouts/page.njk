<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{{ creator.creator }} | IndieNodes</title>
		<meta name="description" content="{{ creator.why }}" />

		{# How IndieNodes confirms this page belongs to the creator it names.
		   Required whenever a creator has an active ring entry; this page IS
		   their source_url once they join, and the ring's participation
		   checker reads served HTML without running JavaScript. #}
		{% if creator.ring.verificationToken %}
			<meta name="indienode-verification" content="{{ creator.ring.verificationToken }}" />
		{% endif %}

		{% if creator.site_icon %}
		<link rel="icon" href="{{ creator.site_icon }}" />
		{% else %}
		<link rel="icon" href="{{ publicRoot }}favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="{{ publicRoot }}favicon-16.png" type="image/png" sizes="16x16" />
		{% endif %}
		<link rel="stylesheet" href="{{ assetRoot }}/css/base.css" />
		<link rel="stylesheet" href="{{ assetRoot }}/css/skins/{{ creator.theme.skin or 'card' }}.css" />

		{# A creator's chosen accent, inlined AFTER the stylesheet links so it
		   wins, gated on a strict hex pattern so an unexpected value in the
		   YAML can't inject anything beyond a color. An unset or invalid
		   value emits nothing and the skin's own default accent stands. #}
		{% set accent = creator.theme.accent %}
		{% if accent and (accent | regexMatch('^#[0-9a-fA-F]{6}$')) %}
			<style>
				:root {
					--accent: {{ accent }};
				}
			</style>
		{% endif %}
        {% if creator.theme.effects.cherryBlossoms %}
          <link rel="stylesheet" href="{{ assetRoot }}/css/blossoms.css" />
        {% endif %}
        {% if creator.theme.effects.waves %}
          <link rel="stylesheet" href="{{ assetRoot }}/css/waves.css" />
        {% endif %}
        {% if creator.theme.effects.dustParticles %}
          <link rel="stylesheet" href="{{ assetRoot }}/css/dust.css" />
        {% endif %}
        <style>
          {% if creator.theme.backgroundColor and (creator.theme.backgroundColor | regexMatch('^#[0-9a-fA-F]{6}$')) %}
          :root { --bg: {{ creator.theme.backgroundColor }}; }
          {% endif %}
          {% if creator.theme.backgroundColorDark and (creator.theme.backgroundColorDark | regexMatch('^#[0-9a-fA-F]{6}$')) %}
          @media (prefers-color-scheme: dark) { :root { --bg: {{ creator.theme.backgroundColorDark }}; } }
          {% endif %}
        </style>
        {% if creator.theme.glassPanels != false %}
          <link rel="stylesheet" href="{{ assetRoot }}/css/glass-panels.css" />
        {% endif %}
        <link rel="stylesheet" href="{{ assetRoot }}/css/site-controls.css" />
	</head>
	<body data-type="{{ creator.type }}"{% if creator.theme.effects.blossomGlassGlow %} data-blossom-glow{% endif %}>
        {% if creator.theme.backgroundImage %}
          <div class="site-backdrop" style="background-image: url('{{ creator.theme.backgroundImage }}')" aria-hidden="true"></div>
        {% endif %}
		{% if creator.theme.effects.cherryBlossoms %}
          <canvas class="blossoms" aria-hidden="true"></canvas>
        {% endif %}
        {% if creator.theme.effects.dustParticles %}
          <canvas class="dust-particles" aria-hidden="true"></canvas>
        {% endif %}
        {% if creator.theme.effects.waves %}
          {% include "components/waves.njk" %}
        {% endif %}
        <div class="page">
			{% include "components/hero.njk" %}

			{% if creator.sections.about and creator.bio %}
				{% include "components/about.njk" %}
			{% endif %}

			{% set hasCosplayTab = creator.cosplay.groups.length %}
            {% set hasMoreWorksTab = creator.more_works.length %}
            {% if hasCosplayTab or hasMoreWorksTab %}
              <nav class="profile-tabs" data-tabs data-reveal aria-label="Creator interests">
                <a href="#music">Music</a>{% if hasCosplayTab %}<a href="#cosplay">Cosplay</a>{% endif %}{% if hasMoreWorksTab %}<a href="#more-works">More Works</a>{% endif %}
              </nav>
              <div id="music">
            {% endif %}

			{% if creator.sections.works %}
				{% include "components/works/" + creator.type + ".njk" %}
			{% endif %}

			{% if hasCosplayTab or hasMoreWorksTab %}
              </div>
            {% endif %}
            {% if hasCosplayTab %}
              <div id="cosplay">{% include "components/cosplay.njk" %}</div>
            {% endif %}
            {% if hasMoreWorksTab %}
              <div id="more-works">{% include "components/more-works.njk" %}</div>
            {% endif %}

			{% if creator.sections.links %}
				{% include "components/links.njk" %}
			{% endif %}

            {% include "components/footer.njk" %}
		</div>

        <div class="site-controls">
          <button class="bg-reveal-toggle" type="button" aria-pressed="false" aria-label="View background">
            <svg class="control-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </button>
          {% if creator.theme.effects.cherryBlossoms or creator.theme.effects.dustParticles or creator.theme.effects.waves %}
            <div class="fx-panel">
              <div class="fx-panel__list" id="fx-panel-list">
                {% if creator.theme.effects.waves %}<button class="waves-toggle" hidden type="button" aria-pressed="false">Pause waves</button>{% endif %}
                {% if creator.theme.effects.cherryBlossoms %}<button class="blossoms-toggle" hidden type="button" aria-pressed="false">Pause petals</button>{% endif %}
                {% if creator.theme.effects.dustParticles %}<button class="dust-particles-toggle" hidden type="button" aria-pressed="false">Pause dust</button>{% endif %}
              </div>
              <button class="fx-panel-toggle" type="button" aria-expanded="false" aria-controls="fx-panel-list" aria-label="Effects">
                <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m12 3-1.9 5.8a2 2 0 0 1-1.287 1.288L3 12l5.8 1.9a2 2 0 0 1 1.288 1.287L12 21l1.9-5.8a2 2 0 0 1 1.287-1.288L21 12l-5.8-1.9a2 2 0 0 1-1.288-1.287Z" />
                </svg>
              </button>
            </div>
          {% endif %}
        </div>

		<script src="{{ assetRoot }}/js/reveal.js" defer></script>
        {% if creator.cosplay.groups.length or creator.more_works.length %}<script src="{{ assetRoot }}/js/tabs.js" defer></script>{% endif %}
        <script src="{{ assetRoot }}/js/bg-reveal.js" defer></script>
        {% if creator.theme.effects.waves %}<script src="{{ assetRoot }}/js/waves.js" defer></script>{% endif %}
        {% if creator.theme.effects.cherryBlossoms %}<script src="{{ assetRoot }}/js/blossoms.js" defer></script>{% endif %}
        {% if creator.theme.effects.dustParticles %}<script src="{{ assetRoot }}/js/dust.js" defer></script>{% endif %}
        {% if creator.theme.effects.cherryBlossoms or creator.theme.effects.dustParticles or creator.theme.effects.waves %}
          <script src="{{ assetRoot }}/js/fx-panel.js" defer></script>
        {% endif %}
        {% if creator.type == 'audio' and creator.sections.works and creator.tracks.length %}
          <script src="{{ assetRoot }}/js/vendor/wavesurfer.min.js" defer></script>
          <script src="{{ assetRoot }}/js/waveforms.js" defer></script>
        {% endif %}
	</body>
</html>
