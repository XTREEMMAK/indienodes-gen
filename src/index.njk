<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>KJNet Creator Pages</title>
		<meta
			name="description"
			content="Hosted creator pages for the IndieNodes ring, served from KJNet."
		/>
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
		<link rel="stylesheet" href="{{ assetRoot }}/css/base.css" />
		<link rel="stylesheet" href="{{ assetRoot }}/css/skins/card.css" />
	</head>
	<body>
		<div class="page">
			<header class="hero">
				<div class="hero__inner" data-reveal="sequence">
					<div class="hero__body">
						<h1 class="hero__name" data-reveal-item>KJNet Creator Pages</h1>
						<p class="hero__why" data-reveal-item>
							A small number of hosted pages for creators who fit the
							<a href="{{ site.ringOrigin }}" target="_blank" rel="noopener noreferrer"
								>IndieNodes</a
							>
							ring but whose own site can't yet carry a Node. This is not a directory —
							discovery happens on the ring itself.
						</p>
					</div>
				</div>
			</header>
			<section class="section" data-reveal>
				<p class="prose">
					If you were sent here by a creator's own link, you're in the right place —
					just not at a listing. Each page lives at its own address
					(<code>pages.kjnet.us/&lt;creator&gt;</code>), handed out individually rather
					than browsed from here.
				</p>
			</section>
		</div>
		<script src="{{ assetRoot }}/js/reveal.js" defer></script>
	</body>
</html>
